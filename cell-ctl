#!/usr/bin/env bash
# Central de Controle e Execucao da Scientific Systems Exploration Platform (SSEP)
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${SCRIPT_DIR}/.venv/bin/python"

if [ ! -f "$PYTHON_BIN" ]; then
    PYTHON_BIN="python3"
fi

exec "$PYTHON_BIN" "${SCRIPT_DIR}/manage.py" "$@"
