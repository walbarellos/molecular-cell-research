{
  "$defs": {
    "Quantity": {
      "additionalProperties": false,
      "description": "Representacao de grandeza fisica quantitativa com unidade e incerteza obrigatorias.",
      "properties": {
        "value": {
          "description": "Valor numerico central medido ou computado",
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/StandardUnit",
          "description": "Unidade fisica estrita"
        },
        "uncertainty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Margem de incerteza associada",
          "title": "Uncertainty"
        },
        "uncertainty_type": {
          "$ref": "#/$defs/UncertaintyType",
          "default": "none"
        },
        "representation": {
          "$ref": "#/$defs/RepresentationType",
          "default": "point_estimate"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "RepresentationType": {
      "enum": [
        "point_estimate",
        "distribution",
        "interval",
        "bounds"
      ],
      "title": "RepresentationType",
      "type": "string"
    },
    "SoftLifecycleStatus": {
      "description": "Ciclo de vida do registro cientifico (sem delecao destrutiva).",
      "enum": [
        "active",
        "superseded",
        "deprecated",
        "invalidated",
        "retracted"
      ],
      "title": "SoftLifecycleStatus",
      "type": "string"
    },
    "StandardUnit": {
      "enum": [
        "nm",
        "um",
        "mm",
        "m",
        "nm/s",
        "um/s",
        "m/s",
        "ms",
        "s",
        "min",
        "h",
        "pM",
        "nM",
        "uM",
        "mM",
        "M",
        "pN",
        "nN",
        "N",
        "degC",
        "K",
        "J",
        "kJ/mol",
        "kcal/mol",
        "k_B*T",
        "1/s",
        "1/(uM*s)",
        "1/(mM*s)",
        "dimensionless",
        "%",
        "count"
      ],
      "title": "StandardUnit",
      "type": "string"
    },
    "UncertaintyType": {
      "enum": [
        "none",
        "standard_error",
        "standard_deviation",
        "confidence_interval_95",
        "range",
        "systematic_error"
      ],
      "title": "UncertaintyType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Medicao contextualizada ligada a uma propriedade especifica de uma entidade.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "lifecycle_status": {
      "$ref": "#/$defs/SoftLifecycleStatus",
      "default": "active"
    },
    "version": {
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "quantity": {
      "$ref": "#/$defs/Quantity",
      "description": "Grandeza quantitativa aferida"
    },
    "measured_property": {
      "description": "Nome padronizado da propriedade (ex: velocity, stall_force, run_length)",
      "title": "Measured Property",
      "type": "string"
    },
    "entity_id": {
      "description": "Identificador da entidade a que se refere a medicao",
      "title": "Entity Id",
      "type": "string"
    },
    "conditions": {
      "additionalProperties": true,
      "description": "Condicoes experimentais na realizacao da medicao",
      "title": "Conditions",
      "type": "object"
    },
    "method": {
      "description": "Metodo experimental ou analitico utilizado",
      "title": "Method",
      "type": "string"
    },
    "observation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Identificador da observacao que documenta esta medicao",
      "title": "Observation Id"
    }
  },
  "required": [
    "quantity",
    "measured_property",
    "entity_id",
    "method"
  ],
  "title": "Measurement",
  "type": "object"
}